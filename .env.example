# Speech-to-text provider: sarvam (default) or assemblyai. Switching back is this one line.
STT_PROVIDER=sarvam

# Sarvam (used when STT_PROVIDER=sarvam). The key stays on the server: the browser streams to the
# relay (`npm run relay`), which connects to Sarvam. Realtime streaming is beta on Sarvam's side.
SARVAM_API_KEY=
# Where the browser reaches the relay. Must be wss:// once the app itself is served over https.
STT_RELAY_URL=ws://localhost:8787
# saaras:v3-realtime (default) or saaras:v4. Only saaras:v4 accepts keyterms.
SARVAM_MODEL=saaras:v3-realtime
# hi-IN (default) for Hinglish visits, or auto to detect across 22 Indian languages.
SARVAM_LANGUAGE_CODE=hi-IN
# Comma-separated domain terms, used only with saaras:v4 (max 50).
SARVAM_KEYTERMS=bukhar,khansi,BCG,OPV,pentavalent,ORS,Anganwadi,ASHA

# AssemblyAI (used when STT_PROVIDER=assemblyai)
ASSEMBLYAI_API_KEY=
# Streaming model. universal-3-5-pro is the only tier with Hindi + code-switching.
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
# Comma-separated domain terms for keyterm prompting (village names, symptoms, vaccines)
ASSEMBLYAI_KEYTERMS=bukhar,khansi,BCG,OPV,pentavalent,ORS,Anganwadi,ASHA

# LLM for extraction: Gemini native API. Leave the key empty to use the rule-based fallback.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=

# Supabase (optional). Without these, visits are stored in data/visits.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
